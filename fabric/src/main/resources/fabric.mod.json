{
  "schemaVersion": 1,
  "id": "toroidal_world",
  "version": "${version}",
  "name": "Toroidal World",
  "description": "Circumnavigate the world — walk, sail or fly past the border and come out on the far side. No walls, no teleports, one seamless world.",
  "authors": [
    "Anyttng"
  ],
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.toroidalworld.ToroidalWorldFabric"
    ],
    "client": [
      "com.toroidalworld.client.ToroidalWorldFabricClient"
    ],
    "modmenu": [
      "com.toroidalworld.client.ToroidalWorldModMenu"
    ]
  },
  "mixins": [
    "toroidal_world.mixins.json",
    "toroidal_world.shape.mixins.json",
    "toroidal_world.fabric.mixins.json",
    "toroidal_world.compat.journeymap.mixins.json",
    "toroidal_world.compat.xaero.mixins.json",
    "toroidal_world.compat.ftbchunks.mixins.json",
    "toroidal_world.compat.c2me.mixins.json",
    "toroidal_world.compat.distanthorizons.mixins.json",
    "toroidal_world.compat.terrablender.mixins.json",
    "toroidal_world.compat.scalablelux.mixins.json",
    "toroidal_world.compat.biolith.mixins.json",
    "toroidal_world.compat.wover.mixins.json",
    "toroidal_world.compat.betterend.mixins.json",
    "toroidal_world.compat.sodium.mixins.json",
    "toroidal_world.compat.simpleatlas.mixins.json",
    "toroidal_world.compat.lithium.mixins.json"
  ],
  "accessWidener": "toroidal_world.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "26.1.x"
  },
  "suggests": {
    "modmenu": "*"
  },
  "breaks": {
    "journeymap": "<${journeymap_min_version}",
    "ftbchunks": "<${ftbchunks_min_version}",
    "c2me": ["<${c2me_min_version}", "${c2me_broken_version}"]
  }
}
