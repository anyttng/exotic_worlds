{
  "schemaVersion": 1,
  "id": "exotic_worlds",
  "version": "${version}",
  "name": "Exotic Worlds",
  "description": "Circumnavigate the world — walk, sail or fly past the border and come out on the far side. No walls, no teleports, one seamless world.",
  "authors": [
    "Anyttng"
  ],
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.exoticworlds.ExoticWorldsFabric"
    ],
    "client": [
      "com.exoticworlds.client.ExoticWorldsFabricClient"
    ],
    "journeymap": [
      "com.exoticworlds.compat.journeymap.ToroidalJourneyMapPlugin"
    ],
    "modmenu": [
      "com.exoticworlds.client.ExoticWorldsModMenu"
    ]
  },
  "mixins": [
    "exotic_worlds.mixins.json",
    "exotic_worlds.shape.mixins.json",
    "exotic_worlds.fabric.mixins.json",
    "exotic_worlds.compat.journeymap.mixins.json",
    "exotic_worlds.compat.xaero.mixins.json",
    "exotic_worlds.compat.ftbchunks.mixins.json",
    "exotic_worlds.compat.ftbxaerocompat.mixins.json",
    "exotic_worlds.compat.jmi.mixins.json",
    "exotic_worlds.compat.c2me.mixins.json",
    "exotic_worlds.compat.distanthorizons.mixins.json",
    "exotic_worlds.compat.create.mixins.json",
    "exotic_worlds.compat.sable.mixins.json",
    "exotic_worlds.compat.aeronautics.mixins.json",
    "exotic_worlds.compat.terrablender.mixins.json",
    "exotic_worlds.compat.scalablelux.mixins.json",
    "exotic_worlds.compat.biolith.mixins.json",
    "exotic_worlds.compat.reterraforged.mixins.json",
    "exotic_worlds.compat.wover.mixins.json",
    "exotic_worlds.compat.betterend.mixins.json",
    "exotic_worlds.compat.sodium.mixins.json",
    "exotic_worlds.compat.lithium.mixins.json"
  ],
  "accessWidener": "exotic_worlds.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "1.21.1"
  },
  "suggests": {
    "modmenu": "*"
  },
  "breaks": {
    "journeymap": "<${journeymap_min_version}",
    "ftbchunks": "<${ftbchunks_min_version}",
    "c2me": "<${c2me_min_version}"
  }
}
